{
  "name": "agenticbudgetrouter",
  "title": "Agentic Budget Router",
  "description": "Quote model and tool-call cost, apply team budget policies, request approval, and issue spend receipts before agents continue.",
  "version": "1.0.0",
  "websiteUrl": "https://agenticbudgetrouter.clauxel.com/",
  "documentationUrl": "https://agenticbudgetrouter.clauxel.com/mcp/",
  "endpointUrl": "https://agenticbudgetrouter.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://agenticbudgetrouter.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://agenticbudgetrouter.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://agenticbudgetrouter.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "starter",
        "name": "Starter",
        "monthlyUsd": 49
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 149
      },
      {
        "id": "finance",
        "name": "Finance",
        "monthlyUsd": 399
      }
    ]
  },
  "tools": [
    {
      "name": "quote_agentic_budget",
      "description": "Agentic Budget Router quote agentic budget",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sample": {
            "type": "string",
            "description": "Workflow sample, schema, policy fixture, or agent output."
          },
          "context": {
            "type": "string",
            "description": "Optional review context."
          }
        },
        "required": [
          "sample"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "receipt_id": {
            "type": "string"
          },
          "usage_units": {
            "type": "integer"
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
